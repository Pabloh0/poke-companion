# Copia este archivo como .env.local y rellena los valores.
# .env.local NUNCA se sube a Git (está en .gitignore).

# --- Web (públicas: llegan al navegador) ---
# Supabase → Project Settings → API Keys. Usa la clave "publishable"
# (sb_publishable_…), NUNCA la "secret" (sb_secret_…).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# --- Importación de datos (solo en tu ordenador; nunca en Vercel) ---
# Supabase → botón "Connect" → "Session pooler" (funciona con IPv4).
# Sustituye [YOUR-PASSWORD] por la contraseña de la base de datos.
# Si la contraseña tiene caracteres especiales (@ : / # ?), codifícalos en URL.
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Ruta al certificado de Supabase (por defecto: supabase/certs/prod-ca-2021.crt)
# SUPABASE_DB_CA_CERT=supabase/certs/prod-ca-2021.crt
